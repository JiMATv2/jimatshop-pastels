## Vite env vars (client-side)
## Used by `src/lib/api/mobileProducts.ts`

# Optional: defaults to https://ex_supabase.jimatbiz.com
VITE_EX_SUPABASE_API_URL=https://ex_supabase.jimatbiz.com

# Optional: if not set, app falls back to local SQLite-seeded catalog
VITE_SUPABASE_API_TOKEN=jimat_supabase_secret_2025_changeme

## Google OAuth Client IDs
# Web client ID (for web browsers and as fallback)
VITE_GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# Android client ID (for Android apps - from Google Cloud Console OAuth 2.0 Client ID)
# Get this from: https://console.cloud.google.com/apis/credentials
# Example: 552393042714-q5q6tslqlfthv19rmcdpa5l4f6106aan.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID_ANDROID=552393042714-q5q6tslqlfthv19rmcdpa5l4f6106aan.apps.googleusercontent.com

## Supabase Configuration
VITE_SUPABASE_URL=your-supabase-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key